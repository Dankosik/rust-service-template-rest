# Whole-file portable ownership for committed-source sync. Directory entries
# own their descendants; generated adapters and managed settings are derived by
# scripts/lib/template_state.py rather than copied from this manifest.
template-owned.paths
AGENTS.md
.agents/skills/
.agents/roles/
.agents/role-classes/
.agents/codex-project.toml
.agents/adapters/claude/CLAUDE.md
