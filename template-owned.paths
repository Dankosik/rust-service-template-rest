# Whole-file portable ownership for committed-source sync. Directory entries
# own their descendants; generated adapters and managed settings are derived by
# scripts/template/state.py rather than copied from this manifest.
template-owned.paths
AGENTS.md
.agents/skills/
.agents/roles/
.agents/role-classes/
.agents/codex-project.toml
.agents/adapters/claude/CLAUDE.md
.agents/adapters/claude/settings.json
.agents/adapters/qwen/QWEN.md
.agents/adapters/qwen/settings.json
.agents/adapters/cursor/rules/agent-harness.mdc
.agents/adapters/grok/Grok.md
.agents/adapters/grok/rules/harness.md
.agents/adapters/opencode/opencode.json
.agents/adapters/opencode/.gitignore
.agents/adapters/opencode/rules/harness.md
.agents/adapters/opencode/commands/orchestrator.md
.agents/adapters/opencode/plugins/task-subagents.js
.agents/adapters/antigravity/rules/antigravity-harness.md
docs/spec-first-workflow.md
docs/spec-first-workflow/
docs/agent-harness.md
docs/agent-harness/
docs/prompt-maintenance.md
docs/prompt-composition.md
docs/skill-authoring.md
docs/validation-routing.md
docs/build-speed.md
Makefile
make/template.mk
tools/versions.env
scripts/verify/
scripts/checks/
scripts/image/
scripts/harness/
scripts/template/state.py
scripts/template/sync.py
