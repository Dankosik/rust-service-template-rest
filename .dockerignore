# Only what build/docker/Dockerfile reads enters the build context, so a
# change elsewhere never invalidates the cooked dependency layer.
#
# rust-toolchain.toml stays out on purpose: the builder's FROM tag is the
# toolchain authority for the image, and a toolchain file in the context
# makes rustup download clippy and rustfmt in every stage that runs cargo.
*
!Cargo.toml
!Cargo.lock
!crates/
!.cargo/
.cargo/*
!.cargo/config.toml
!scripts/
scripts/*
!scripts/grpc-protoc.py
!tools/
tools/*
!tools/versions.env
# The migrate binary embeds the migration set at compile time.
!migrations/
# A workspace member cargo must see; its tests and fixtures are not built.
!test/Cargo.toml
!test/src/
# Integration tests are not compiled by `cargo build --bin`.
crates/*/tests/
