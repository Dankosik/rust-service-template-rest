# Only what build/docker/Dockerfile reads enters the build context, so a
# change elsewhere never invalidates the cooked dependency layer.
#
# rust-toolchain.toml stays out on purpose: the builder's FROM tag is the
# toolchain authority for the image, and a toolchain file in the context
# makes rustup download clippy and rustfmt in every stage that runs cargo.
*
!Cargo.toml
!Cargo.lock
!LICENSE
!deny.toml
!build/docker/rust-notices.py
!build/docker/rust-notices.toml
!vendor/
vendor/*
!vendor/hotpath/
# template:begin postgres:dockerignore-postgres-vendor
!vendor/sqlx-core/
!vendor/sqlx-postgres/
# template:end postgres:dockerignore-postgres-vendor
# template:begin messaging:dockerignore-messaging-vendor
!vendor/async-nats/
# template:end messaging:dockerignore-messaging-vendor
# template:begin object-storage:dockerignore-object-storage-vendor
!vendor/aws-runtime/
!vendor/aws-smithy-http-client/
# template:end object-storage:dockerignore-object-storage-vendor
!vendor/hyper-util/
# template:begin tonic:dockerignore-tonic-vendor
!vendor/tonic/
# template:end tonic:dockerignore-tonic-vendor
# template:begin clickhouse:dockerignore-clickhouse-vendor
!vendor/clickhouse/
# template:end clickhouse:dockerignore-clickhouse-vendor
!crates/
# `sqlx::query!` reads its statement metadata at compile time.
!.sqlx/
# The migrate binary embeds the migration set at compile time.
!migrations/
# Cargo and chef must discover real targets even when profile pruning removes
# this workspace member's library and fixture binary. Release builds compile
# no test; IMAGE_TESTS=unit runs the unit tests, which read crate fixtures
# under crates/*/tests/, the shared test fixtures and the local configuration.
!test/Cargo.toml
!test/src/
!test/tests/
!test/fixtures/
!env/config/
# PGO=train runs the instrumented service against these requests.
!build/docker/pgo-train.sh
