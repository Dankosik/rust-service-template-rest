{
  "format": [
    "rust"
  ],
  "mode": "mild",
  "minTokens": 100,
  "minLines": 15,
  "threshold": 0,
  "reporters": [
    "console"
  ],
  "failOnEmpty": true,
  "gitignore": true,
  "pattern": "crates/**/*.rs",
  "ignore": [
    "**/target/**",
    "**/tests/**",
    "**/benches/**",
    "**/examples/**",
    "**/fixtures/**",
    "crates/*/src/tests.rs",
    "crates/grpc-contracts/src/generated/**"
  ]
}
