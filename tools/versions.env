# One pin per developer and delivery tool, consumed by Makefile (`include`),
# shell (`.`), and CI (`grep -v '^#' … >> "$GITHUB_ENV"`). NAME=value only:
# no quotes, spaces, or expansions. Decisions and the reason for each
# tool: docs/ci-cd-production-ready.md.

CARGO_DENY_VERSION=0.20.2
CARGO_NEXTEST_VERSION=0.9.148
CARGO_SHEAR_VERSION=1.14.0
TYPOS_VERSION=1.52.0
ZIZMOR_VERSION=1.31.1

CARGO_MUTANTS_VERSION=27.1.0

# template:begin postgres:tools-sqlx-cli-version
# Built from crates.io by `make sqlx-prepare` and `make sqlx-check`, locally
# and in CI (no release binaries exist); those targets prove the pin. Keep it
# on the `sqlx` version Cargo.toml pins: the metadata format belongs to both.
SQLX_CLI_VERSION=0.9.0
# template:end postgres:tools-sqlx-cli-version

# Cargo tools the image builder stage downloads as upstream musl release
# binaries; each digest is the release's own .sha256 for that archive. The
# Dockerfile carries the same values as ARG defaults because Railway passes no
# build arguments; `make dockerfile-check` asserts they agree. Base images are
# pinned by digest in the Dockerfile FROM lines, which Dependabot's docker
# ecosystem updates.
CARGO_CHEF_VERSION=0.1.78
CARGO_CHEF_X86_64_SHA256=aca691abfbfbbe00d482e0ed2249eec3091b65e96a0ce92947fb5b254d48b16d
CARGO_CHEF_AARCH64_SHA256=cd59b90fce5fa84c4189648fec33404ec5491791eebdb812df5e7fca8336408d
