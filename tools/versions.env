# One pin per developer and delivery tool, consumed by make (`include`),
# shell (`.`), and CI (`grep -v '^#' … >> "$GITHUB_ENV"`). NAME=value only:
# no quotes, spaces, or expansions; `make tools-check` proves the shape and
# that every pin resolves. Bump a line deliberately in a reviewed commit;
# Dependabot does not manage this file. Decisions and the reason for each
# tool: docs/ci-cd-production-ready.md.

# Cargo tools. Locally `make` builds each one once from crates.io into the
# Git common directory; CI installs the same versions as prebuilt binaries.
CARGO_DENY_VERSION=0.20.2
CARGO_SHEAR_VERSION=1.13.4
ZIZMOR_VERSION=1.30.1

# Optional task-local compiler cache; provisioning stays explicit and never
# runs as a Make/tools-check side effect.
SCCACHE_VERSION=0.18.0

# template:begin postgres:tools-sqlx-cli-version
# Built from crates.io by `make sqlx-prepare` and `make sqlx-check`, locally
# and in CI (no release binaries exist); those targets prove the pin. Keep it
# on the `sqlx` version Cargo.toml pins: the metadata format belongs to both.
SQLX_CLI_VERSION=0.9.0
# template:end postgres:tools-sqlx-cli-version

# Cargo tools built inside the image builder stage. The Dockerfile carries
# the same values as ARG defaults because Railway passes no build arguments;
# `make tools-check` asserts they agree. Base images are pinned by digest in
# the Dockerfile FROM lines, which Dependabot's docker ecosystem updates.
CARGO_CHEF_VERSION=0.1.78
CARGO_AUDITABLE_VERSION=0.7.6

# Node.js tools through `npx <package>@<version>`.
REDOCLY_CLI_VERSION=2.53.3
JSCPD_VERSION=5.4.0
# template:begin postgres:tools-squawk-cli-version
SQUAWK_CLI_VERSION=2.66.0
# template:end postgres:tools-squawk-cli-version

# Go tools through `go run <module>@v<version>` (module checksum database).
OASDIFF_VERSION=1.32.1
GITLEAKS_VERSION=8.30.1
ACTIONLINT_VERSION=1.7.12
# template:begin messaging:tools-nats-cli-version
NATS_CLI_VERSION=0.5.0
# template:end messaging:tools-nats-cli-version
# template:begin grpc:tools-buf-version
BUF_VERSION=1.73.0
# template:end grpc:tools-buf-version

# Containers, pinned by digest.
SHELLCHECK_IMAGE=koalaman/shellcheck:v0.11.0@sha256:61862eba1fcf09a484ebcc6feea46f1782532571a34ed51fedf90dd25f925a8d
TRIVY_IMAGE=aquasec/trivy:0.74.0@sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969
LYCHEE_IMAGE=lycheeverse/lychee:0.24.2@sha256:e2d19e57cf6ab037026f20b8e449a1f30d9d7f81eef4194763aab2eab20bd28d

# Publication only: installed by sigstore/cosign-installer in cd.yml to sign
# and verify the pushed image.
COSIGN_VERSION=3.1.3

# template:begin postgres:tools-promtool-version
# Official Prometheus v3.5.0 sha256sums.txt; only promtool is extracted.
PROMTOOL_VERSION=3.5.0
PROMTOOL_DARWIN_AMD64_SHA256=5856d0c306e7d852d9a79788b20acb630501b3fab120b69f5317d6b0732dea57
PROMTOOL_DARWIN_ARM64_SHA256=c17bc2c992f0b5515eebe2b4ccd626214f8e309a0fe6ec40ed13c42ec13d05fb
PROMTOOL_LINUX_AMD64_SHA256=e811827af26d822afb09a4f28314f61b618b12cff5369835a67f674d8b46f39a
PROMTOOL_LINUX_ARM64_SHA256=173389cc42bf09c4e6e54cb53fa07a5a835d7c261e14775d2183181d6e385d1c
# template:end postgres:tools-promtool-version
