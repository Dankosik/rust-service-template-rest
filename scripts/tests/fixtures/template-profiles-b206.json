    {
      "path": "Cargo.toml",
      "old": "https://github.com/Dankosik/rust-service-template-rest",
      "template": "https://github.com/{repository_path}",
      "count": 1,
      "encoding": "url"
    },
    {
      "path": "crates/service/Cargo.toml",
