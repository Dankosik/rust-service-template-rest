{
  "schema_version": 2,
  "source_only": [
    "template/",
    "docs/assets/banner.png",
    "docs/template-init.md"
  ],
  "auto_enable": [
    {
      "when": {"outbound_auth": "oauth2-client-credentials"},
      "set": {"outbound_http": "bounded"}
    }
  ],
  "requires": [
    {
      "when": {"http_idempotency": "postgres"},
      "require": {"database": "postgres"},
      "message": "HTTP_IDEMPOTENCY=postgres requires DATABASE=postgres"
    },
    {
      "when": {"http_idempotency": "postgres"},
      "require": {"authn": "!none"},
      "message": "HTTP_IDEMPOTENCY=postgres requires AUTHN=oidc-jwt or oidc-introspection"
    },
    {
      "when": {"jobs": "postgres"},
      "require": {"database": "postgres"},
      "message": "JOBS=postgres requires DATABASE=postgres"
    },
    {
      "when": {"outbox": "postgres"},
      "require": {"all": [{"database": "postgres"}, {"jobs": "postgres"}, {"messaging": "nats-jetstream"}]},
      "message": "OUTBOX=postgres requires DATABASE=postgres, JOBS=postgres, and MESSAGING=nats-jetstream"
    },
    {
      "when": {"webhooks": "durable"},
      "require": {"all": [{"database": "postgres"}, {"jobs": "postgres"}, {"outbound_http": "bounded"}]},
      "message": "WEBHOOKS=durable requires DATABASE=postgres, JOBS=postgres, and OUTBOUND_HTTP=bounded"
    },
    {
      "when": {"inbound_webhooks": "standard-webhooks"},
      "require": {"all": [{"database": "postgres"}, {"jobs": "postgres"}]},
      "message": "INBOUND_WEBHOOKS=standard-webhooks requires DATABASE=postgres and JOBS=postgres"
    },
    {
      "when": {"service_auth": "jwt"},
      "require": {"grpc": "enabled"},
      "message": "SERVICE_AUTH=jwt requires GRPC=enabled"
    }
  ],
  "identity": [
    {
      "path": "Cargo.toml",
      "old": "https://github.com/Dankosik/rust-service-template-rest",
      "template": "https://github.com/{repository_path}",
      "count": 1,
      "encoding": "url"
    },
    {
      "path": "crates/service/Cargo.toml",
      "old": "name = \"service\"",
      "template": "name = \"{service_name}\"",
      "count": 2,
      "encoding": "toml_string"
    },
    {
      "path": "crates/service/Cargo.toml",
      "old": "description = \"Service entrypoint and runtime composition root.\"",
      "template": "description = \"{description}\"",
      "count": 1,
      "encoding": "toml_string"
    },
    {
      "path": "crates/config/src/observability.rs",
      "old": "const DEFAULT_SERVICE_NAME: &str = \"service\";",
      "template": "const DEFAULT_SERVICE_NAME: &str = \"{service_name}\";",
      "count": 1,
      "encoding": "rust_string"
    },
    {
      "path": "crates/infra-grpc/src/status.rs",
      "old": "pub const ERROR_DOMAIN: &str = \"service\";",
      "template": "pub const ERROR_DOMAIN: &str = \"{service_name}\";",
      "count": 1,
      "encoding": "rust_string"
    },
    {
      "path": "crates/service/src/api.rs",
      "old": "rust-service-template-rest",
      "template": "{service_name}",
      "count": 1,
      "encoding": "rust_string"
    },
    {
      "path": "crates/service/src/api.rs",
      "old": "HTTP contract served by the `service` binary: platform probes and feature operations, with RFC 9457 problem responses from one closed catalog.",
      "template": "{description}",
      "count": 1,
      "encoding": "rust_string"
    },
    {
      "path": "crates/service/tests/lifecycle.rs",
      "old": "CARGO_BIN_EXE_service",
      "template": "CARGO_BIN_EXE_{service_name}",
      "count": 1,
      "encoding": "text"
    },
    {
      "path": "justfile",
      "old": "service_package := env(\"SERVICE_PACKAGE\", \"service\")",
      "template": "service_package := env(\"SERVICE_PACKAGE\", \"{service_name}\")",
      "count": 1,
      "encoding": "json_string"
    },
    {
      "path": "justfile",
      "old": "service_bin := env(\"SERVICE_BIN\", \"service\")",
      "template": "service_bin := env(\"SERVICE_BIN\", \"{service_name}\")",
      "count": 1,
      "encoding": "json_string"
    },
    {
      "path": "justfile",
      "old": "runtime_image := env(\"RUNTIME_IMAGE\", \"service:ci\")",
      "template": "runtime_image := env(\"RUNTIME_IMAGE\", \"{service_name}:ci\")",
      "count": 1,
      "encoding": "json_string"
    },
    {
      "path": "build/docker/Dockerfile",
      "old": "ARG SERVICE_PACKAGE=service",
      "template": "ARG SERVICE_PACKAGE={service_name}",
      "count": 1,
      "encoding": "text"
    },
    {
      "path": "build/docker/Dockerfile",
      "old": "ARG SERVICE_BIN=service",
      "template": "ARG SERVICE_BIN={service_name}",
      "count": 2,
      "encoding": "text"
    },
    {
      "path": "README.md",
      "old": "# rust-service-template-rest\n",
      "template": "# {service_name}\n",
      "count": 1,
      "encoding": "markdown"
    },
    {
      "path": "README.md",
      "old": "Rust REST API service template on Tokio and axum, built to be developed by coding agents.",
      "template": "{description}",
      "count": 1,
      "encoding": "markdown"
    },
    {
      "path": "README.md",
      "old": "Repository: https://github.com/Dankosik/rust-service-template-rest",
      "template": "Repository: {repository}",
      "count": 1,
      "encoding": "url"
    },
    {
      "path": ".github/CODEOWNERS",
      "old": "* @Dankosik",
      "template": "* {codeowner}",
      "count": 1,
      "encoding": "text"
    },
    {
      "path": ".github/CODEOWNERS",
      "old": "/crates/ @Dankosik",
      "template": "/crates/ {codeowner}",
      "count": 1,
      "encoding": "text"
    },
    {
      "path": ".github/CODEOWNERS",
      "old": "/.github/workflows/ @Dankosik",
      "template": "/.github/workflows/ {codeowner}",
      "count": 1,
      "encoding": "text"
    },
    {
      "path": ".github/CODEOWNERS",
      "old": "/Cargo.toml @Dankosik",
      "template": "/Cargo.toml {codeowner}",
      "count": 1,
      "encoding": "text"
    },
    {
      "path": ".github/CODEOWNERS",
      "old": "/Cargo.lock @Dankosik",
      "template": "/Cargo.lock {codeowner}",
      "count": 1,
      "encoding": "text"
    },
    {
      "path": ".github/CODEOWNERS",
      "old": "/rust-toolchain.toml @Dankosik",
      "template": "/rust-toolchain.toml {codeowner}",
      "count": 1,
      "encoding": "text"
    },
    {
      "path": ".gitleaks.toml",
      "old": "rust-service-template-rest gitleaks configuration",
      "template": "{service_name} gitleaks configuration",
      "count": 1,
      "encoding": "toml_string"
    },
    {
      "path": "SECURITY.md",
      "old": "https://github.com/Dankosik/rust-service-template-rest/security/advisories/new",
      "template": "https://github.com/{repository_path}/security/advisories/new",
      "count": 1,
      "encoding": "url"
    },
    {
      "path": ".github/ISSUE_TEMPLATE/config.yml",
      "old": "https://github.com/Dankosik/rust-service-template-rest/security/advisories/new",
      "template": "https://github.com/{repository_path}/security/advisories/new",
      "count": 1,
      "encoding": "url"
    },
    {
      "path": ".github/ISSUE_TEMPLATE/config.yml",
      "old": "https://github.com/Dankosik/rust-service-template-rest#documentation",
      "template": "https://github.com/{repository_path}#documentation",
      "count": 1,
      "encoding": "url"
    },
    {
      "path": ".railway/railway.ts",
      "old": "const name = \"service\";",
      "template": "const name = \"{service_name}\";",
      "count": 1,
      "encoding": "json_string"
    },
    {
      "path": ".railway/railway.ts",
      "old": "github(\"Dankosik/rust-service-template-rest\")",
      "template": "github(\"{repository_path}\")",
      "count": 1,
      "encoding": "json_string"
    }
  ],
