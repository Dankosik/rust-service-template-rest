{
  "$schema": "https://opencode.ai/config.json",
  "model": "xai/grok-4.6",
  "subagent_depth": 3,
  "experimental": {
    "subagent_depth": 3
  },
  "agent": {
    "general": {
      "permission": {
        "task": {
          "*": "deny",
          "reviewer-agent": "allow"
        }
      }
    },
    "build": {
      "prompt": "{file:.opencode/rules/harness.md}",
      "permission": {
        "skill": {
          "acceptance-unit-lead": "deny",
          "agent-prompt-composer": "deny",
          "grilling": "deny",
          "idea-refine": "deny",
          "planning-and-task-breakdown": "deny",
          "spec-document-designer": "deny",
          "spec-first-brainstorming": "deny"
        }
      }
    },
    "plan": {
      "permission": {
        "skill": {
          "acceptance-unit-lead": "deny",
          "agent-prompt-composer": "deny",
          "grilling": "deny",
          "idea-refine": "deny",
          "planning-and-task-breakdown": "deny",
          "spec-document-designer": "deny",
          "spec-first-brainstorming": "deny"
        }
      }
    }
  }
}
